#!/bin/sh
# Fast checks before a commit: only what the staged files can affect. The full suite is
# scripts/check.sh, run before a story is reported done.
#
# The checks run on the staged snapshot, never on the working tree: the index is exported into a
# temporary directory and every check runs there, with the check scripts as staged. Untracked
# files and unstaged changes (someone else's work in progress) are not in it and cannot change
# the result; a staged file whose working-tree copy differs is checked as staged. The snapshot
# has no .git; the check tests, which clone the repository, get a throwaway one made from it.
#
# The hook that judges a commit is the one in that commit. core.hooksPath points at the working
# tree, so the hook git starts may be a half-edited copy. Its first block therefore reads the
# staged scripts/hooks/pre-commit from the index and, if it differs from the running file, runs it
# and returns its exit code; sh reads a script one command at a time, so nothing after that block
# in the running file is read. AP_PRE_COMMIT_STAGED_HOOK stops the staged hook from handing over
# again. A commit that deletes the hook is judged by the running one. Keep the block short: an
# unstaged edit to the block itself still takes effect.
#
# Staged names are handled NUL-separated or through git pathspecs, never split on white space,
# so names with spaces or newlines are checked. Deleted paths count as changed: a commit that
# only deletes files still has its snapshot checked.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if [ -z "${AP_PRE_COMMIT_STAGED_HOOK:-}" ]; then
  hook=$(mktemp "${TMPDIR:-/tmp}/pre-commit-hook.XXXXXX")
  trap 'rm -f "$hook"' EXIT
  trap 'exit 1' HUP INT TERM
  if git show :scripts/hooks/pre-commit >"$hook" 2>/dev/null && ! cmp -s "$0" "$hook"; then
    echo "pre-commit: running the staged scripts/hooks/pre-commit, which differs from $0"
    rc=0
    AP_PRE_COMMIT_STAGED_HOOK=1 sh "$hook" "$@" || rc=$?
    exit "$rc"
  fi
  rm -f "$hook"; trap - EXIT HUP INT TERM
fi
unset AP_PRE_COMMIT_STAGED_HOOK
work=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
# Read the index while GIT_INDEX_FILE is still set: `git commit <paths>` and `git commit -a`
# point it at a temporary index that holds what will actually be committed.
# changed: every staged path, deletions and both sides of a rename included.
# content: the staged paths that have content in the snapshot.
git diff --cached --name-only -z --no-renames >"$work/changed"
[ -s "$work/changed" ] || exit 0
git diff --cached --name-only -z --no-renames --diff-filter=d >"$work/content"
git diff --cached --name-only -z --no-renames --diff-filter=d -- '*.md' ':(exclude)scripts/tests/' >"$work/md"
touches() { ! git diff --cached --quiet --no-renames -- "$@"; }
docs=; scripts=; contracts=; go=
touches 'docs/' && docs=1
touches 'scripts/' && scripts=1
touches ':(glob)**/api/preview/**/*openapi.yaml' 'src/engine/api/ruleset*' && contracts=1
touches '*.go' '*go.mod' '*go.sum' ':(glob)src/*/api/**' && go=1
snap="$work/snapshot"
git checkout-index --all --prefix="$snap/"
tracked=$(git ls-files -z | tr -cd '\0' | wc -c | tr -d ' ')

# Git sets GIT_DIR and GIT_INDEX_FILE for hooks; tests that create throwaway repositories would
# otherwise act on this repository. Nothing below needs them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$snap"
run() { echo "pre-commit: $1"; }

echo "pre-commit: staged snapshot of $tracked tracked files in $snap; $(tr -cd '\0' <"$work/changed" | wc -c | tr -d ' ') staged:"
tr '\0' '\n' <"$work/changed" | sed 's/^/  /'

run "root layout"
python3 scripts/layout-check.py >/dev/null || { python3 scripts/layout-check.py; exit 1; }
run "secret scan of the staged files"
# Judged by grep's output, not xargs' exit code: xargs exits 0 on an empty list and 123 when any
# batch of names has no match, even if another batch has one.
xargs -0 -r grep -HnE 'sk-ant-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}' -- <"$work/content" \
  >"$work/secrets" 2>/dev/null || true
if [ -s "$work/secrets" ]; then
  cat "$work/secrets"; echo "pre-commit: secret found in staged files" >&2; exit 1
fi
if [ -n "$docs" ]; then
  run "knowledge bundle"
  python3 scripts/okf.py check >/dev/null || { python3 scripts/okf.py check; exit 1; }
fi
if [ -n "$scripts" ]; then
  run "check tests"
  # Some tests clone the repository: give the snapshot its own repository, holding exactly it.
  # -f and an empty excludes file: neither .gitignore nor a global exclude may drop a tracked file.
  git init -q && git -c core.excludesFile=/dev/null -c core.autocrlf=false add -A -f \
    && git -c user.name=pre-commit -c user.email=pre-commit@localhost \
    -c commit.gpgsign=false commit -q --no-verify -m "staged snapshot"
  python3 -m unittest discover -s scripts/tests -p 'test_*.py' >"$work/unittest.log" 2>&1 \
    || { cat "$work/unittest.log"; exit 1; }
  tail -3 "$work/unittest.log"
fi
if [ -s "$work/md" ]; then
  run "markdown"
  # "--": every name after it is a literal path, not a glob.
  xargs -0 scripts/npm-tool.sh markdownlint-cli2 --config scripts/repo.markdownlint-cli2.jsonc -- <"$work/md"
fi
if [ -n "$contracts" ]; then
  run "contracts"
  for f in $(find src -path '*/api/preview/*' -name 'openapi.yaml'); do
    scripts/npm-tool.sh spectral lint "$f" --ruleset src/engine/api/ruleset.yaml --fail-severity error
  done
fi
if [ -n "$go" ]; then
  run "generated code, go vet and race tests"
  scripts/check.sh --go-only
fi
echo "pre-commit: staged snapshot passed"
