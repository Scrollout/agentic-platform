#!/bin/sh
# Quick static checks before a commit, of what the staged files can affect: root layout, secret
# scan, knowledge bundle, markdown, contract lint, committed generated blocks, and gofmt and go vet
# of each changed Go module. No test suite runs here: the full scripts/check.sh runs in CI on every
# push (research D41, ADR 0044), and a task is done when that run is green.
#
# The checks run on the staged snapshot, never on the working tree: the index is exported into a
# temporary directory and every check runs there, with the check scripts as staged. Untracked
# files and unstaged changes (someone else's work in progress) are not in it and cannot change
# the result; a staged file whose working-tree copy differs is checked as staged. The snapshot
# has no .git; the check tests, which clone the repository, get a throwaway one made from it.
#
# The hook that judges a commit is the one in that commit. core.hooksPath points at the working
# tree, so the hook git starts may be a half-edited copy. Its first block therefore reads the
# staged scripts/hooks/pre-commit from the index and, if it differs from the running file, execs
# it in a fresh temporary folder; sh reads a script one command at a time, so nothing after that
# block in the running file is read. No variable decides this: a run is the staged hook exactly
# when its own file equals the staged one, so a caller cannot skip the handover. exec keeps the
# process: a signal sent to the hook reaches the staged copy, and git waits for it. The staged
# copy recognises its folder by name ($TMPDIR/pre-commit-hook.*) and removes it once it has
# compared itself. A commit that deletes the hook is judged by the running one. Keep the block
# short: an unstaged edit to the block itself still takes effect.
#
# Staged names are handled NUL-separated or through git pathspecs, never split on white space,
# so names with spaces or newlines are checked. Deleted paths count as changed: a commit that
# only deletes files still has its snapshot checked.
set -eu
started=$(date +%s)
root=$(git rev-parse --show-toplevel)
cd "$root"
# self: this run's own folder when it is a handed-over copy, one level below $TMPDIR (no "/" or
# "..", so a crafted $0 cannot point rm -rf elsewhere). Assignments, not tests: under set -e a
# failing git in "$(...)" stops the hook only when the substitution is assigned.
self=; mid=${0#"${TMPDIR:-/tmp}"/pre-commit-hook.}; mid=${mid%/pre-commit}
case $0 in "${TMPDIR:-/tmp}"/pre-commit-hook.*/pre-commit)
  case $mid in */*|.|..|'') ;; *) self=${0%/pre-commit} ;; esac ;;
esac
staged_hook=$(git ls-files -- ':(top)scripts/hooks/pre-commit') \
  || { echo "pre-commit: cannot read the index" >&2; exit 1; }
if [ -n "$staged_hook" ]; then
  hookdir=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-hook.XXXXXX")
  trap 'rm -rf "$hookdir" ${self:+"$self"}' EXIT
  trap 'exit 1' HUP INT TERM
  git show :scripts/hooks/pre-commit >"$hookdir/pre-commit" \
    || { echo "pre-commit: cannot read the staged scripts/hooks/pre-commit" >&2; exit 1; }
  if ! cmp -s "$0" "$hookdir/pre-commit"; then
    echo "pre-commit: running the staged scripts/hooks/pre-commit, which differs from $0"
    [ -z "$self" ] || rm -rf "$self"
    # The EXIT trap stays: it runs only if exec fails, and then removes hookdir.
    trap 'rm -rf "$hookdir"' EXIT
    exec sh "$hookdir/pre-commit" "$@"
  fi
  rm -rf "$hookdir" ${self:+"$self"}; trap - EXIT HUP INT TERM
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
# Read the index while GIT_INDEX_FILE is still set: `git commit <paths>` and `git commit -a`
# point it at a temporary index that holds what will actually be committed.
# changed: every staged path, deletions and both sides of a rename included.
# content: the staged paths that have content in the snapshot.
git diff --cached --name-only -z --no-renames >"$work/changed"
[ -s "$work/changed" ] || exit 0
git diff --cached --name-only -z --no-renames --diff-filter=d >"$work/content"
git diff --cached --name-only -z --no-renames --diff-filter=d -- '*.md' ':(exclude)scripts/tests/' >"$work/md"
touches() { ! git diff --cached --quiet --no-renames -- "$@"; }
docs=; contracts=; go=; inline=
touches 'docs/' && docs=1
touches ':(glob)**/api/preview/**/*openapi.yaml' 'src/engine/api/ruleset*' && contracts=1
touches '*.go' '*go.mod' '*go.sum' ':(glob)src/*/api/**' && go=1
# Committed inline schema blocks (scripts/generate.sh): the files that carry them, their source
# schemas and the generator.
touches ':(glob)src/agents/**/*.yaml' ':(glob)src/**/*.schema.json' 'scripts/generate.sh' && inline=1
# gomods: each Go module of src/go.work (its `use` lines, as staged) with a staged path. The Go
# checks fail closed: an unreadable src/go.work, or a staged Go file in no module, refuses the
# commit rather than skipping gofmt and vet.
gomods=
if [ -n "$go" ]; then
  workfile=$(git show :src/go.work 2>/dev/null) || {
    echo "pre-commit: Go changes are staged but src/go.work cannot be read from the index, so the Go checks cannot run; the commit is refused" >&2; exit 1; }
  mods=$(printf '%s\n' "$workfile" | sed -n 's#^[[:space:]]*\./\([a-z][a-z0-9-]*\)$#\1#p')
  outside_args=
  for m in $mods; do
    if touches "src/$m/"; then gomods="$gomods $m"; fi
    outside_args="$outside_args :(exclude)src/$m/"
  done
  # shellcheck disable=SC2086
  git diff --cached --name-only -z --no-renames --diff-filter=d -- '*.go' $outside_args >"$work/outside"
  if [ -s "$work/outside" ]; then
    echo "pre-commit: these staged Go files are in no module of src/go.work, so gofmt and go vet cannot judge them; the commit is refused:" >&2
    tr '\0' '\n' <"$work/outside" | sed 's/^/  /' >&2; exit 1
  fi
fi
snap="$work/snapshot"
git checkout-index --all --prefix="$snap/"
tracked=$(git ls-files -z | tr -cd '\0' | wc -c | tr -d ' ')

# Git sets GIT_DIR and GIT_INDEX_FILE for hooks; tests that create throwaway repositories would
# otherwise act on this repository. Nothing below needs them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$snap"
run() { echo "pre-commit: $1"; }

echo "pre-commit: staged snapshot of $tracked tracked files in $snap; $(tr -cd '\0' <"$work/changed" | wc -c | tr -d ' ') staged:"
tr '\0' '\n' <"$work/changed" | sed 's/^/  /'

run "root layout"
python3 scripts/layout-check.py >/dev/null || { python3 scripts/layout-check.py; exit 1; }
run "secret scan of the staged files"
# Only regular files are read. A symlink is never followed (its target may be outside the
# repository, or a device): its target text, which is what git stores, is scanned instead. A
# gitlink has no content here. Any other entry, or any tool failure, fails the hook: a scan that
# did not run is not a clean scan. Each grep's exit status is mapped inside its batch (0 or 1 is
# fine, anything else exits 255, which stops xargs with 124), because xargs folds every status
# from 1 to 125, including grep's 2 and a shell's 126 and 127, into 123. A hit is told by the
# output, so the scan passes only when xargs exits 0 and writes nothing.
secret='sk-ant-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}'
scan_failed() {
  cat "$work/secrets.err" >&2
  echo "pre-commit: the secret scan failed ($1, exit $2); the commit is refused" >&2; exit 1
}
rc=0
xargs -0 -r sh -c 'w=$1; shift; for p do
    if [ -L "$p" ]; then printf "%s\0" "$p" >>"$w/links" || exit 255
    elif [ -f "$p" ]; then printf "%s\0" "$p" >>"$w/files" || exit 255
    elif [ -d "$p" ]; then :
    else echo "pre-commit: staged entry missing from the snapshot: $p" >&2; exit 255
    fi
  done' sh "$work" <"$work/content" 2>"$work/secrets.err" || rc=$?
[ "$rc" -eq 0 ] || scan_failed "sorting the staged entries" "$rc"
: >"$work/secrets"
if [ -s "$work/files" ]; then
  xargs -0 -r sh -c 'grep -HnE -e "$0" -- "$@"; rc=$?; [ "$rc" -le 1 ] || exit 255' "$secret" \
    <"$work/files" >"$work/secrets" 2>"$work/secrets.err" || rc=$?
  [ "$rc" -eq 0 ] || scan_failed "grep over the staged files" "$rc"
fi
if [ -s "$work/links" ]; then
  xargs -0 -r sh -c 'for p do
      t=$(readlink -- "$p") || exit 255
      rc=0; printf "%s\n" "$t" | grep -E -e "$0" >/dev/null || rc=$?
      case $rc in 0) printf "%s: symlink target: %s\n" "$p" "$t" ;; 1) ;; *) exit 255 ;; esac
    done' "$secret" <"$work/links" >>"$work/secrets" 2>"$work/secrets.err" || rc=$?
  [ "$rc" -eq 0 ] || scan_failed "grep over the staged symlink targets" "$rc"
fi
if [ -s "$work/secrets" ]; then
  cat "$work/secrets"; echo "pre-commit: secret found in staged files" >&2; exit 1
fi
if [ -n "$docs" ]; then
  run "knowledge bundle"
  python3 scripts/okf.py check >/dev/null || { python3 scripts/okf.py check; exit 1; }
fi
if [ -s "$work/md" ]; then
  run "markdown"
  # "--": every name after it is a literal path, not a glob.
  xargs -0 scripts/npm-tool.sh markdownlint-cli2 --config scripts/repo.markdownlint-cli2.jsonc -- <"$work/md"
fi
if [ -n "$contracts" ]; then
  run "contracts"
  for f in $(find src -path '*/api/preview/*' -name 'openapi.yaml'); do
    scripts/npm-tool.sh spectral lint "$f" --ruleset src/engine/api/ruleset.yaml --fail-severity error
  done
fi
if [ -n "$go" ] || [ -n "$inline" ]; then
  run "committed generated blocks"
  scripts/generate.sh --check-committed
fi
if [ -n "$go" ]; then
  # Each Go module of src/go.work with a staged path: gofmt (testdata excluded: fixtures may be
  # unformatted on purpose) and go vet, offline, in the pinned Go container, with the generated
  # code made first in the snapshot (it is not committed). One container per module, named only
  # by its folder.
  run "generated code for go vet"
  scripts/generate.sh >/dev/null
  image=$(awk '$1=="golang"{print $2}' src/deploy/images.lock)
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/agentic-platform/go"
  for m in $gomods; do
    run "gofmt and go vet of src/$m"
    docker run --rm --network none -v "$snap/src:/src" -w "/src/$m" -v "$cache:/gopath" \
      --user "$(id -u):$(id -g)" -e GOPATH=/gopath -e GOCACHE=/gopath/cache -e GOTOOLCHAIN=local \
      -e GOPROXY=off -e GOFLAGS=-mod=readonly "$image" sh -ec 'out=$(find . -name "*.go" -not -path "*/testdata/*" -print | xargs -r gofmt -l); [ -z "$out" ] || { echo "gofmt: these files are not formatted:"; echo "$out"; exit 1; }; go vet ./...'
  done
fi
echo "pre-commit: staged snapshot passed"
echo "pre-commit: done in $(( $(date +%s) - started )) s"
