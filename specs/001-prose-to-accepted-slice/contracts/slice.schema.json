{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slice.schema.json",
  "title": "Slice",
  "type": "object",
  "required": [
    "id",
    "description",
    "goals",
    "terms",
    "rules",
    "examples",
    "state",
    "contract"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S-[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "proposed",
        "questions-open",
        "checked",
        "approved",
        "building",
        "done",
        "handed-over",
        "expired"
      ]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "definition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "examples": {
      "type": "string",
      "description": "Gherkin text: one Rule block per rule, tagged with the rule ID."
    },
    "contract": {
      "type": "string",
      "description": "OpenAPI 3.1 document; every operation carries x-rules."
    },
    "questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-[0-9]+$"
          },
          "about": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string",
            "maxLength": 200
          },
          "answered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "part",
          "content_hash",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "part": {
            "enum": [
              "goals",
              "rules",
              "contract"
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "passed"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "part": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "title": {
      "type": "string"
    },
    "parts": {
      "type": "object",
      "required": [
        "goals",
        "rules",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "goals": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "SHA-256 of each part's RFC 8785 canonical JSON; rules covers rules, examples and terms."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "pattern",
        "system",
        "response",
        "terms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[0-9]+$"
        },
        "goal": {
          "type": "string",
          "pattern": "^G-[0-9]+$"
        },
        "pattern": {
          "enum": [
            "ubiquitous",
            "event",
            "state",
            "unwanted",
            "option"
          ]
        },
        "precondition": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "response": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T-[0-9]+$"
          }
        },
        "text": {
          "type": "string",
          "description": "Derived EARS sentence; never edited by hand."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "state"
              }
            }
          },
          "then": {
            "required": [
              "precondition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "enum": [
                  "event",
                  "unwanted"
                ]
              }
            }
          },
          "then": {
            "required": [
              "trigger"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "option"
              }
            }
          },
          "then": {
            "required": [
              "feature"
            ]
          }
        }
      ]
    }
  }
}