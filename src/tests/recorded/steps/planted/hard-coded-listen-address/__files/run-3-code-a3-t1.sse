event: content_block_delta
data: {"delta":{"partial_json":"{\"content\":\"// Package app is the in-memory notes service: the code step replaces the seam New.\\npackage app\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"net/http\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"sync\\\"\\n\\n\\t\\\"example.com/service/gen\\\"\\n)\\n\\n// Note is one note: a text with an id.\\ntype Note struct {\\n\\tID   int    `json:\\\"id\\\"`\\n\\tText string `json:\\\"text\\\"`\\n}\\n\\n// Service keeps the notes in creation order; ids start at 1.\\ntype Service struct {\\n\\tmu    sync.Mutex\\n\\tnotes []Note\\n}\\n\\nvar _ gen.ServerInterface = (*Service)(nil)\\n\\n// New returns an empty service (the seam the tests serve).\\nfunc New() gen.ServerInterface { return &Service{notes: []Note{}} }\\n\\nfunc write(w http.ResponseWriter, status int, v any) {\\n\\tw.Header().Set(\\\"Content-Type\\\", \\\"application/json\\\")\\n\\tw.WriteHeader(status)\\n\\t_ = json.NewEncoder(w).Encode(v)\\n}\\n\\n// ListNotes returns every note, in creation order.\\nfunc (s *Service) ListNotes(w http.ResponseWriter, r *http.Request) {\\n\\ts.mu.Lock()\\n\\tdefer s.mu.Unlock()\\n\\twrite(w, http.StatusOK, s.notes)\\n}\\n\\n// CreateNote stores a note with the next id, or refuses an empty text (or one of only spaces)\\n// with a 400.\\nfunc (s *Service) CreateNote(w http.ResponseWriter, r *http.Request) {\\n\\tvar in struct {\\n\\t\\tText string `json:\\\"text\\\"`\\n\\t}\\n\\tif err := json.NewDecoder(r.Body).Decode(&in); err != nil || strings.TrimSpace(in.Text) == \\\"\\\" {\\n\\t\\twrite(w, http.StatusBadRequest, map[string]string{\\\"message\\\": \\\"the text of a note must not be empty\\\"})\\n\\t\\treturn\\n\\t}\\n\\ts.mu.Lock()\\n\\tdefer s.mu.Unlock()\\n\\tn := Note{ID: len(s.notes) + 1, Text: in.Text}\\n\\ts.notes = append(s.notes, n)\\n\\twrite(w, http.StatusCreated, n)\\n}\\n\",\"path\":\"/projects/hard-coded-listen-address-3/internal/app/app.go\"}","type":"input_json_delta"},"index":0,"type":"content_block_delta"}

