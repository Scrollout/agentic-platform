event: content_block_delta
data: {"delta":{"partial_json":"{\"content\":\"package tests\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"context\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"net/http\\\"\\n\\t\\\"net/http/httptest\\\"\\n\\t\\\"regexp\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/cucumber/godog\\\"\\n)\\n\\ntype world struct {\\n\\tsrv    *httptest.Server\\n\\tstatus int\\n\\tbody   map[string]any\\n}\\n\\nvar quoted = regexp.MustCompile(`\\\"([^\\\"]*)\\\"`)\\n\\nfunc (w *world) create(text string) error {\\n\\tb, _ := json.Marshal(map[string]string{\\\"text\\\": text})\\n\\tresp, err := http.Post(w.srv.URL+\\\"/notes\\\", \\\"application/json\\\", bytes.NewReader(b))\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tdefer resp.Body.Close()\\n\\tw.status, w.body = resp.StatusCode, nil\\n\\t_ = json.NewDecoder(resp.Body).Decode(&w.body)\\n\\treturn nil\\n}\\n\\nfunc (w *world) list() ([]string, error) {\\n\\tresp, err := http.Get(w.srv.URL + \\\"/notes\\\")\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tdefer resp.Body.Close()\\n\\tvar notes []struct{ Text string }\\n\\tif err := json.NewDecoder(resp.Body).Decode(&notes); err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"the list is not a JSON array of notes (status %d): %w\\\", resp.StatusCode, err)\\n\\t}\\n\\ttexts := []string{}\\n\\tfor _, n := range notes {\\n\\t\\ttexts = append(texts, n.Text)\\n\\t}\\n\\treturn texts, nil\\n}\\n\\nfunc initScenario(sc *godog.ScenarioContext) {\\n\\tw := &world{}\\n\\tsc.Before(func(ctx context.Context, _ *godog.Scenario) (context.Context, error) {\\n\\t\\tw.srv, w.status, w.body = httptest.NewServer(handler()), 0, nil\\n\\t\\treturn ctx, nil\\n\\t})\\n\\tsc.After(func(ctx context.Context, _ *godog.Scenario, _ error) (context.Context, error) {\\n\\t\\tw.srv.Close()\\n\\t\\treturn ctx, nil\\n\\t})\\n\\tsc.Step(`^notes (.+) were created$`, func(list string) error {\\n\\t\\tfor _, m := range quoted.FindAllStringSubmatch(list, -1) {\\n\\t\\t\\tif err := w.create(m[1]); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\tif w.status != http.StatusCreated {\\n\\t\\t\\t\\treturn fmt.Errorf(\\\"creating the note %q answered %d, want 201\\\", m[1], w.status)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n\\tsc.Step(`^the user lists notes$`, func() error { _, err := w.list(); return err })\\n\\tsc.Step(`^the notes are returned in the order (.+)$`, func(list string) error {\\n\\t\\tgot, err := w.list()\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\twant := []string{}\\n\\t\\tfor _, m := range quoted.FindAllStringSubmatch(list, -1) {\\n\\t\\t\\twant = append(want, m[1])\\n\\t\\t}\\n\\t\\tif fmt.Sprint(got) != fmt.Sprint(want) {\\n\\t\\t\\treturn fmt.Errorf(\\\"the notes are %q, want %q\\\", got, want)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n\\tsc.Step(`^the user creates a note with text \\\"([^\\\"]*)\\\"$`, w.create)\\n\\tsc.Step(`^the user creates a note with empty text$`, func() error { return w.create(\\\"\\\") })\\n\\tsc.Step(`^the note is returned with id (\\\\d+)$`, func(s string) error {\\n\\t\\tif w.status != http.StatusCreated {\\n\\t\\t\\treturn fmt.Errorf(\\\"the status is %d, want 201\\\", w.status)\\n\\t\\t}\\n\\t\\tif got := fmt.Sprint(w.body[\\\"id\\\"]); got != s {\\n\\t\\t\\treturn fmt.Errorf(\\\"the note has the id %s, want %s\\\", got, s)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n\\tsc.Step(`^the creation is refused$`, func() error {\\n\\t\\tif w.status < 400 || w.status > 499 {\\n\\t\\t\\treturn fmt.Errorf(\\\"the status is %d, want a refusal (4xx)\\\", w.status)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n\\tsc.Step(`^the response status is (\\\\d+)$`, func(s string) error {\\n\\t\\tif n, _ := strconv.Atoi(s); w.status != n {\\n\\t\\t\\treturn fmt.Errorf(\\\"the status is %d, want %d\\\", w.status, n)\\n\\t\\t}\\n\\t\\treturn nil\\n\\t})\\n}\\n\\nfunc TestFeatures(t *testing.T) {\\n\\tsuite := godog.TestSuite{\\n\\t\\tScenarioInitializer: initScenario,\\n\\t\\tOptions:             &godog.Options{Format: \\\"pretty\\\", Paths: []string{\\\"../features\\\"}, TestingT: t, Strict: true},\\n\\t}\\n\\tif suite.Run() != 0 {\\n\\t\\tt.Fatal(\\\"godog: at least one scenario failed\\\")\\n\\t}\\n}\\n\",\"path\":\"/projects/outside-scope-1/tests/features_test.go\"}","type":"input_json_delta"},"index":0,"type":"content_block_delta"}

