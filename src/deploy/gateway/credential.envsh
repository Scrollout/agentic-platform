# Sourced by the nginx image's entrypoint before the templates are rendered
# (mount at /docker-entrypoint.d/05-credential.envsh, executable). Reads the provider credential
# from a file and exports it in the entrypoint's own shell only; it is not a container variable.
f="${GATEWAY_CREDENTIAL_FILE:-/run/secrets/anthropic_api_key}"
if [ ! -r "$f" ] || [ ! -s "$f" ]; then
  echo "gateway: credential file '$f' is missing, unreadable or empty" >&2
  exit 1
fi
ANTHROPIC_API_KEY="$(tr -d '\r\n' < "$f")"
if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "gateway: credential file '$f' is empty" >&2
  exit 1
fi
export ANTHROPIC_API_KEY
unset f
