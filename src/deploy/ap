#!/bin/sh
# ap: starts, stops and drives the platform on this machine (src/cli/contract.md, research D6).
#
# Runs on the host and calls nothing but `docker` (Compose) and POSIX utilities. Its own commands
# are up, down, build-workers, page, test and registry; build, resume and replay first make the slice's
# workers ready; every other command goes unchanged to the terminal client container, and its exit
# code is returned. Exit codes are the terminal contract's: 3 is a usage error or a command that is
# not available yet; 1 is a failed start or stop.
#
# Values reach Compose only through the environment (never a command line, so `ps` does not show
# them). `up` on a started session keeps its tokens, so running it twice changes nothing; only
# `up` after `down` makes new ones. The session (tokens, paths, port) is kept for later commands in
# ${XDG_STATE_HOME:-$HOME/.local/state}/agentic-platform/session.env, mode 600, removed by `down`.
#
# Images (ADR 0028): build.sh records each signed image as a digest reference in
# ${XDG_STATE_HOME:-$HOME/.local/state}/agentic-platform/images.env. `up` verifies every image it
# passes to Compose with the public key in ${XDG_CONFIG_HOME:-$HOME/.config}/agentic-platform/
# signing/cosign.pub, from a cosign container on the registry's internal network (`ap-signing`),
# against the local registry; any failure stops `up` before anything starts. The session keeps the verified
# references, so later commands start exactly those images. `registry` starts the local registry
# if it isn't running (build.sh and `up` call it).
set -u

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/agentic-platform
sess=$state_dir/session.env
images_env=$state_dir/images.env
pub=${XDG_CONFIG_HOME:-$HOME/.config}/agentic-platform/signing/cosign.pub
# Images `up` needs (it starts engine and page; every client command runs cli) and images it passes
# only when built (their profiles are started later, by build-workers and test).
needed_images="engine page cli"
optional_images="agent check tests"
# shellcheck disable=SC2086
image_vars=$(printf 'AP_IMAGE_%s ' $needed_images $optional_images | tr '[:lower:]' '[:upper:]')
vars="AP_CREDENTIALS_FILE AP_PROJECTS_DIR AP_PAGE_PORT AP_CLIENT_TOKEN AP_PAGE_TOKEN AP_WORKER_TOKEN AP_HOST_USER AP_GATEWAY_IMAGE $image_vars"
default_page_port=7878
default_registry_port=5005
# The registry's names, derived here only. AP_REGISTRY_NAME runs a second, independent registry
# (for example for tests); unset, the names are ap-registry, ap-registry-data and ap-signing.
reg=${AP_REGISTRY_NAME:-ap-registry}
case $reg in [a-z0-9]*[!a-z0-9_.-]* | [!a-z0-9]* | '') printf 'ap: AP_REGISTRY_NAME %s is not a container name ([a-z0-9][a-z0-9_.-]*)\n' "'$reg'" >&2; exit 3 ;; esac
reg_volume=$reg-data
if [ "$reg" = ap-registry ]; then reg_net=ap-signing; else reg_net=$reg-net; fi

say() { printf 'ap: %s\n' "$*" >&2; }
die() { code=$1; shift; say "$*"; exit "$code"; }

usage() {
  cat >&2 <<'EOF'
usage: ap up --credentials <file> --projects <folder>
       ap down
       ap page
       ap build-workers <slice>
       ap test <suite>
       ap registry
       ap <terminal client command> [arguments]   (see src/cli/contract.md)

The credentials file holds only the model provider key and is readable only by you.
AP_PAGE_PORT, if set, chooses the run page's port (default 7878).
AP_REGISTRY_PORT, if set, chooses the local image registry's port (default 5005).
AP_REGISTRY_NAME, if set, runs a second, independent registry under that name (e.g. for tests).
Build the images first with src/deploy/build.sh <name>.
EOF
  exit "${1:-3}"
}

compose() { docker compose -f "$here/compose.yaml" "$@"; }

pin() { awk -v n="$1" '$1 == n { print $2 }' "$here/images.lock"; }

upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

# A reference that resolves in Compose but names no image, for a profile whose image is not built;
# Compose never pulls our images, so starting it fails with "No such image".
placeholder() { printf 'ap-%s:not-built' "$1"; }

# 64 hex characters from the kernel's random source.
rand() { od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; }

# Single-quote a value for the session file, which is read back with `.`.
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Load the session, or stop if the platform was not started.
load() {
  [ -f "$sess" ] || die 3 "the platform is not started; run: ap up --credentials <file> --projects <folder>"
  set -a
  # shellcheck disable=SC1090
  . "$sess"
  set +a
}

# Absolute, symlink-free path of an existing file.
abs_file() { d=$(CDPATH='' cd -- "$(dirname -- "$1")" && pwd -P) && printf '%s/%s' "$d" "$(basename -- "$1")"; }

check_credentials() {
  f=$1
  [ -f "$f" ] || die 3 "credentials file '$f' does not exist or is not a file"
  [ -r "$f" ] || die 3 "credentials file '$f' is not readable"
  [ -s "$f" ] || die 3 "credentials file '$f' is empty"
  set -f
  # shellcheck disable=SC2046
  set -- $(ls -lnL -- "$f")
  set +f
  case $1 in
    -???------ | -???------.) ;;
    *) die 3 "credentials file '$f' must be readable and writable only by you (chmod 600 '$f')" ;;
  esac
  [ "$3" = "$(id -u)" ] || die 3 "credentials file '$f' must be owned by you"
}

# The local image registry (ADR 0028): container $reg from the registry pin, published on
# 127.0.0.1:$AP_REGISTRY_PORT only, data in the volume $reg_volume, and also on the internal network
# $reg_net, where cosign reaches it as $reg:5000. Converges: a registry created from the same pin,
# port and run flags is left alone (only started if stopped); any other is replaced, keeping its
# data volume.
ensure_registry() {
  rport=${AP_REGISTRY_PORT:-$default_registry_port}
  case $rport in '' | *[!0-9]*) die 3 "AP_REGISTRY_PORT '$rport' is not a port number" ;; esac
  [ "$rport" -ge 1 ] && [ "$rport" -le 65535 ] || die 3 "AP_REGISTRY_PORT '$rport' is not a port number"
  rimage=$(pin registry)
  [ -n "$rimage" ] || die 1 "no registry pin in $here/images.lock"
  # The registry's run flags (no value has a space). Their checksum is part of the label, so a
  # change to them, the pin or the port replaces an existing container.
  rflags="--restart no --read-only --tmpfs /tmp:mode=1777,size=64m --cap-drop ALL
    --security-opt no-new-privileges --user 65532:65532 --memory 256m --cpus 1 --pids-limit 128
    -e REGISTRY_LOG_LEVEL=info -v $reg_volume:/var/lib/registry --network bridge
    -p 127.0.0.1:$rport:5000"
  want="$rimage 127.0.0.1:$rport flags:$(printf '%s %s' "$rflags" "$reg_net" | tr -s ' \n' '  ' | cksum | cut -d' ' -f1)"

  docker network inspect "$reg_net" >/dev/null 2>&1 ||
    docker network create --internal "$reg_net" >/dev/null || die 1 "cannot create the network $reg_net"

  have=$(docker container inspect -f '{{index .Config.Labels "org.agentic-platform.registry"}}' "$reg" 2>/dev/null) ||
    have=absent
  if [ "$have" != absent ] && [ "$have" != "$want" ]; then
    say "replacing the image registry $reg ($have) with $want; its data is kept"
    docker rm -f "$reg" >/dev/null || die 1 "cannot remove the old container $reg"
    have=absent
  fi
  if [ "$have" = absent ]; then
    if ! docker volume inspect "$reg_volume" >/dev/null 2>&1; then
      docker volume create "$reg_volume" >/dev/null || die 1 "cannot create the volume $reg_volume"
      # A new volume belongs to root; hand it to the registry's user. This one-off container runs
      # as root with CHOWN as its only capability and no network.
      docker run --rm --network none --read-only --cap-drop ALL --cap-add CHOWN \
        --security-opt no-new-privileges --user 0:0 -v "$reg_volume:/var/lib/registry" \
        --entrypoint chown "$rimage" 65532:65532 /var/lib/registry >/dev/null ||
        die 1 "cannot prepare the volume $reg_volume"
    fi
    # shellcheck disable=SC2086
    docker create --name "$reg" --label "org.agentic-platform.registry=$want" $rflags "$rimage" >/dev/null ||
      die 1 "cannot create the container $reg"
    docker network connect "$reg_net" "$reg" || die 1 "cannot attach $reg to $reg_net"
  fi
  if [ "$(docker container inspect -f '{{.State.Running}}' "$reg" 2>/dev/null)" = true ]; then
    return 0
  fi
  docker start "$reg" >/dev/null || die 1 "cannot start the container $reg"
  i=0
  until docker exec "$reg" wget -q -O /dev/null http://127.0.0.1:5000/v2/ >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 20 ] || die 1 "the image registry did not become ready; see: docker logs $reg"
    sleep 1
  done
  say "the image registry $reg is running on 127.0.0.1:$rport"
}

# Read images.env into AP_IMAGE_<NAME> for the images Compose uses. Every line must be a digest
# reference in the form build.sh writes; a missing needed image stops with the build to run.
read_images() {
  [ -f "$images_env" ] && [ -r "$images_env" ] ||
    die 1 "no images recorded in $images_env; build them first: src/deploy/build.sh engine (and page, cli)"
  bad=$(grep -Evx 'AP_IMAGE_[A-Z]+=127\.0\.0\.1:[0-9]{1,5}/ap-[a-z]+@sha256:[0-9a-f]{64}' "$images_env" | head -n 1)
  [ -z "$bad" ] || die 1 "$images_env has a line build.sh does not write: '$bad'; rebuild with src/deploy/build.sh <name>"
  for n in $needed_images $optional_images; do
    v=AP_IMAGE_$(upper "$n")
    val=$(sed -n "s/^$v=//p" "$images_env" | tail -n 1)
    case $val in
      '') ;;
      */ap-"$n"@sha256:*) ;;
      *) die 1 "$images_env: $v names another image ($val); rebuild with src/deploy/build.sh $n" ;;
    esac
    if [ -z "$val" ]; then
      case " $needed_images " in *" $n "*) die 1 "no $n image recorded in $images_env; run: src/deploy/build.sh $n" ;; esac
      val=$(placeholder "$n")
    fi
    eval "$v=\$val"
  done
}

# Verify one image's signature with the public key, from a cosign container on the internal
# network only, against the registry's internal name. The private key is never mounted.
verify_image() {
  vname=$1 vref=$2
  out=$(docker run --rm --network "$reg_net" --read-only --cap-drop ALL --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" -v "$pub:/k/cosign.pub:ro" "$cosign_image" verify --key /k/cosign.pub \
    --insecure-ignore-tlog --allow-http-registry "$reg:5000/ap-$vname@${vref#*@}" 2>&1) || {
    printf '%s\n' "$out" >&2
    die 1 "the $vname image $vref failed signature verification; nothing was started (rebuild it with src/deploy/build.sh $vname)"
  }
  say "verified the signature of $vref"
}

cmd_up() {
  cred='' proj=''
  while [ $# -gt 0 ]; do
    case $1 in
      --credentials) [ $# -ge 2 ] || usage; cred=$2; shift 2 ;;
      --projects) [ $# -ge 2 ] || usage; proj=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$cred" ] && [ -n "$proj" ] || usage
  [ "$(id -u)" != 0 ] || die 3 "do not run ap as root: the gateway runs as your user"

  check_credentials "$cred"
  cred=$(abs_file "$cred") || die 3 "credentials file '$cred' cannot be resolved"
  [ -d "$proj" ] || die 3 "projects folder '$proj' does not exist"
  [ -w "$proj" ] || die 3 "projects folder '$proj' is not writable"
  proj=$(CDPATH='' cd -- "$proj" && pwd -P) || die 3 "projects folder '$proj' cannot be resolved"
  case $cred in "$proj"/*) die 3 "the credentials file must not be inside the projects folder" ;; esac

  # A started session is kept as it is (constitution XVII: a second `up` changes nothing): its
  # tokens and, unless AP_PAGE_PORT is set, its port. Only after `down` does `up` make new tokens.
  old_client='' old_page='' old_worker='' old_port=''
  if [ -e "$sess" ] || [ -L "$sess" ]; then
    broken="the session file $sess is unreadable or incomplete; run: ap down"
    [ -f "$sess" ] && [ -r "$sess" ] || die 1 "$broken"
    # shellcheck disable=SC1090,SC2086
    old=$(unset $vars; . "$sess" >/dev/null 2>&1 &&
      printf '%s %s %s %s' "${AP_CLIENT_TOKEN:-}" "${AP_PAGE_TOKEN:-}" "${AP_WORKER_TOKEN:-}" "${AP_PAGE_PORT:-}") ||
      die 1 "$broken"
    # shellcheck disable=SC2086
    set -- $old
    [ $# -eq 4 ] || die 1 "$broken"
    old_client=$1 old_page=$2 old_worker=$3 old_port=$4
    for t in "$old_client" "$old_page" "$old_worker"; do
      [ "${#t}" -ge 32 ] || die 1 "$broken"
      case $t in *[!0-9a-f]*) die 1 "$broken" ;; esac
    done
    [ "$old_client" != "$old_page" ] && [ "$old_client" != "$old_worker" ] && [ "$old_page" != "$old_worker" ] ||
      die 1 "$broken"
  fi

  port=${AP_PAGE_PORT:-${old_port:-$default_page_port}}
  case $port in '' | *[!0-9]*) die 3 "AP_PAGE_PORT '$port' is not a port number" ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die 3 "AP_PAGE_PORT '$port' is not a port number"

  gateway_image=$(pin nginx)
  [ -n "$gateway_image" ] || die 1 "no nginx pin in $here/images.lock"
  cosign_image=$(pin cosign)
  [ -n "$cosign_image" ] || die 1 "no cosign pin in $here/images.lock"

  # Every image Compose is given is verified before anything starts (constitution VIII, ADR 0028).
  read_images
  [ -f "$pub" ] && [ -r "$pub" ] || die 1 "no public key at $pub; build the images first with src/deploy/build.sh <name>"
  ensure_registry
  for n in $needed_images $optional_images; do
    eval "val=\$AP_IMAGE_$(upper "$n")"
    [ "$val" = "$(placeholder "$n")" ] || verify_image "$n" "$val"
  done

  if [ -n "$old_client" ]; then
    client=$old_client page=$old_page worker=$old_worker
    say "the platform's session is already started; keeping its tokens"
  else
    # A new session: fresh tokens, one per kind of caller (research D12).
    client=$(rand) page=$(rand) worker=$(rand)
    [ "${#client}" -ge 32 ] && [ "$client" != "$page" ] && [ "$client" != "$worker" ] && [ "$page" != "$worker" ] ||
      die 1 "could not generate distinct session tokens"
  fi

  AP_CREDENTIALS_FILE=$cred AP_PROJECTS_DIR=$proj AP_PAGE_PORT=$port
  AP_CLIENT_TOKEN=$client AP_PAGE_TOKEN=$page AP_WORKER_TOKEN=$worker
  AP_HOST_USER=$(id -u):$(id -g) AP_GATEWAY_IMAGE=$gateway_image
  # shellcheck disable=SC2086
  export $vars

  old_umask=$(umask)
  umask 077
  mkdir -p -- "$state_dir" || die 1 "cannot create $state_dir"
  tmp=$sess.$$
  {
    echo "# agentic-platform session, written by ap up; removed by ap down"
    for v in $vars; do eval "val=\$$v"; printf '%s=%s\n' "$v" "$(quote "$val")"; done
  } >"$tmp" && chmod 600 "$tmp" && mv -f -- "$tmp" "$sess" || { rm -f -- "$tmp"; die 1 "cannot write $sess"; }
  umask "$old_umask"

  say "starting the platform (gateway, engine, page); run page on http://127.0.0.1:$port"
  compose up -d || die 1 "docker compose up failed; see the messages above (ap down stops what started)"
}

cmd_down() {
  [ $# -eq 0 ] || usage
  # Compose needs every variable to read the file, though none is used to stop. A missing,
  # unreadable or broken session falls back to placeholders, so `down` always recovers.
  AP_CREDENTIALS_FILE=/nonexistent AP_PROJECTS_DIR=/nonexistent AP_PAGE_PORT=$default_page_port
  AP_CLIENT_TOKEN=none AP_PAGE_TOKEN=none AP_WORKER_TOKEN=none AP_HOST_USER=65534:65534
  AP_GATEWAY_IMAGE=none
  for n in $needed_images $optional_images; do eval "AP_IMAGE_$(upper "$n")=\$(placeholder \"\$n\")"; done
  # shellcheck disable=SC2086
  export $vars
  # shellcheck disable=SC1090
  if [ -f "$sess" ] && [ -r "$sess" ] && (. "$sess") >/dev/null 2>&1; then load; fi
  say "stopping the platform; run records and project folders are kept"
  compose --profile '*' down --remove-orphans || die 1 "docker compose down failed; the session is kept"
  rm -f -- "$sess"
}

cmd_page() {
  [ $# -eq 0 ] || usage
  load
  echo "http://127.0.0.1:$AP_PAGE_PORT"
}

# Make the slice's step workers ready (research D5): one container per step of the slice's pattern,
# each with only its step's writable paths writable, registered with the engine.
build_workers() {
  [ -n "${1:-}" ] || usage
  die 3 "build-workers: not available yet: T053 (per-slice step containers; no agent definitions exist in src/agents)"
}

cmd_test() {
  [ $# -ge 1 ] && [ -n "$1" ] || usage
  load
  case $AP_IMAGE_TESTS in
    *@sha256:*) ;;
    *) die 3 "test: not available yet: the test harness image (T024, T046); once built with src/deploy/build.sh tests, run ap up again" ;;
  esac
  compose run --rm tests "$@"
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
  -h | --help) usage 0 ;;
  -*) usage ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  page) cmd_page "$@" ;;
  build-workers) [ $# -eq 1 ] || usage; load; build_workers "$1" ;;
  test) cmd_test "$@" ;;
  registry) [ $# -eq 0 ] || usage; ensure_registry ;;
  build) [ $# -ge 1 ] || usage; load; build_workers "$1" || exit $?; compose run --rm cli build "$@" ;;
  resume | replay)
    # The workers are those of the run's slice; finding it needs the run's record from the engine.
    [ $# -ge 1 ] || usage
    load
    die 3 "$cmd: not available yet: T053 (workers for the run's slice)"
    ;;
  *) load; compose run --rm cli "$cmd" "$@" ;;
esac
