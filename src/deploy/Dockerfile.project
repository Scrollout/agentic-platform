# Project worker image (research D30, ADRs 0032 and 0033): the check program (`/check`, src/engine/cmd/check)
# as the project worker, with git, which it runs to keep each new project's version history. No Go
# toolchain, template or module cache: the project worker runs no check and no procedure. Build
# context: src/. Pins come from build args that deploy/build.sh reads from images.lock: GOLANG_IMAGE
# (the golang line) builds the static binary; ALPINE_IMAGE (the alpine line, pinned by digest) is
# the runtime base; ALPINE_GIT (the alpine-git line) is git's exact package version in that Alpine
# release. Alpine packages have no digest, so git is pinned by exact version only (plan.md,
# Complexity Tracking; owner, 2026-11-13): a new package release makes this build fail until the pin moves.
ARG GOLANG_IMAGE
ARG ALPINE_IMAGE
FROM ${GOLANG_IMAGE} AS build
WORKDIR /src
COPY . .
# src/tests is excluded from the context (src/.dockerignore), so the workspace must not use it.
RUN go work edit -dropuse=./tests
ENV CGO_ENABLED=0 GOFLAGS=-trimpath\ -buildvcs=false GOTOOLCHAIN=local GOTELEMETRY=off
WORKDIR /src/engine
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w -buildid=" -o /out/check ./cmd/check

FROM ${ALPINE_IMAGE}
ARG ALPINE_GIT
# /var/lib/project-worker is where the project worker's volume is mounted (compose.yaml): a new
# volume takes this folder's owner and mode, so mode 1777 lets the project worker, which runs as the
# developer (whose uid is known only at start), write its records there.
RUN apk add --no-cache "git=${ALPINE_GIT}" \
    && adduser -D -u 65532 -h /tmp/home check \
    && mkdir -m 1777 /var/lib/project-worker
COPY --from=build /out/check /check
USER 65532:65532
WORKDIR /tmp
CMD ["/check"]
