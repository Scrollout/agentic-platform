{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slice-proposal.schema.json",
  "title": "SliceProposal",
  "description": "What the analyst agent may output: goals, terms, rules, examples, the contract and new questions. It holds no field the platform or the developer owns.",
  "type": "object",
  "required": [
    "goals",
    "terms",
    "rules",
    "examples",
    "contract"
  ],
  "additionalProperties": false,
  "properties": {
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "slice-defs.schema.json#/$defs/goal"
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "slice-defs.schema.json#/$defs/term"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "slice-defs.schema.json#/$defs/rule"
      }
    },
    "examples": {
      "$ref": "slice-defs.schema.json#/$defs/examples"
    },
    "contract": {
      "$ref": "slice-defs.schema.json#/$defs/contract"
    },
    "questions": {
      "type": "array",
      "maxItems": 10,
      "description": "New questions. Together with the slice's earlier questions there are at most 10; more fail the proposal with TooManyQuestions.",
      "items": {
        "$ref": "slice-defs.schema.json#/$defs/question_draft"
      }
    }
  }
}
